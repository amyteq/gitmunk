{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "gitmunk": {
      "source": { "source": "github", "repo": "amyteq/gitmunk", "ref": "main" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "dev-skills@gitmunk": true,
    "dev-hooks@gitmunk": true
  },
  "permissions": {
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Read(./.env.production)",
      "Read(~/.ssh/**)"
    ]
  }
}
